#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"

while [[ -L "$SOURCE" ]]; do
  SOURCE_DIR="$(
    CDPATH= cd -P -- "$(dirname -- "$SOURCE")" &&
    pwd -P
  )"
  LINK_TARGET="$(readlink "$SOURCE")"

  if [[ "$LINK_TARGET" = /* ]]; then
    SOURCE="$LINK_TARGET"
  else
    SOURCE="$SOURCE_DIR/$LINK_TARGET"
  fi
done

SCRIPT_DIR="$(
  CDPATH= cd -P -- "$(dirname -- "$SOURCE")" &&
  pwd -P
)"

exec python3 "$SCRIPT_DIR/agy_cost_tracker.py" "$@"
