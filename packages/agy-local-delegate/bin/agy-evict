#!/usr/bin/env python3
"""agy-evict — Safe eviction fallback for local model servers and proxies.

WHY THIS EXISTS:
When multiple local model servers (Rapid-MLX, llama-server, MLX LM) hold RAM,
Apple Silicon unified memory can become exhausted, causing system-wide UI freezes.
`agy-evict` safely scans resident processes, protects active attached AGY sessions,
and terminates orphaned or excess servers cleanly without requiring a reboot.

Usage:
  agy-evict [--status] [--dry-run] [--all] [--port <port>] [--pid <pid>]

Options:
  --status, -s    List all running servers, memory RSS, backend, and safety ranks
  --dry-run, -n   Show which server would be evicted without killing
  --all           Evict all resident local model servers and proxies
  --port <port>   Target eviction of a server on a specific port
  --pid <pid>     Target eviction of a specific PID
  -h, --help      Show this help message
"""

import sys
import os
import argparse

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.dirname(SCRIPT_DIR))
import agy_local_delegate_core as core


def print_status(servers):
    if not servers:
        print("No local model servers or proxies detected listening on ports 8000-8015, 8080, or 9191-9205.")
        return

    print("┌──────┬────────┬──────────────┬──────────┬──────────┬────────────┬────────┐")
    print("│ Port │  PID   │   Backend    │  RSS MB  │  Uptime  │  Attached  │  Rank  │")
    print("├──────┼────────┼──────────────┼──────────┼──────────┼────────────┼────────┤")
    for s in servers:
        att_str = "YES (AGY)" if s["attached"] else "no"
        rank_str = f"#{s['rank']}"
        print(f"│ {s['port']:<4} │ {s['pid']:<6} │ {s['backend']:<12} │ {s['rss_mb']:>8.1f} │ {s['etime']:<8} │ {att_str:<10} │ {rank_str:<6} │")
    print("└──────┴────────┴──────────────┴──────────┴──────────┴────────────┴────────┘")
    print("Rank: #0 = unattached proxy/orphan, #1 = unattached model server (prime target), #3 = attached to active AGY session (protected)")


def main():
    parser = argparse.ArgumentParser(description="Antigravity Local Model Server Eviction Utility")
    parser.add_argument("--status", "-s", action="store_true", help="Display running model servers and memory")
    parser.add_argument("--dry-run", "-n", action="store_true", help="Preview eviction without terminating")
    parser.add_argument("--all", action="store_true", help="Evict all resident local servers")
    parser.add_argument("--port", type=int, default=None, help="Target specific port")
    parser.add_argument("--pid", type=int, default=None, help="Target specific PID")

    args = parser.parse_args()

    servers = core.list_resident_servers()

    if args.status:
        print_status(servers)
        sys.exit(0)

    if not servers:
        print("No local model servers or proxies are currently running.")
        sys.exit(0)

    if not args.dry_run and not args.all and args.port is None and args.pid is None:
        # Check if only attached servers exist
        unattached = [s for s in servers if not s["attached"]]
        if not unattached:
            print("⚠️  All running model servers are currently attached to active AGY sessions!")
            print("   Use --all or --port <port> if you explicitly want to terminate an active session.")
            print_status(servers)
            sys.exit(1)

    results = core.evict_servers(
        port=args.port,
        pid=args.pid,
        evict_all=args.all,
        dry_run=args.dry_run,
    )

    if not results:
        print("No matching server found to evict.")
        sys.exit(1)

    total_rss = sum(r["rss_mb"] for r in results)
    action_str = "Would evict" if args.dry_run else "Evicted"

    for r in results:
        print(f"[{action_str}] PID {r['pid']} on port {r['port']} ({r['backend']}) — {r['rss_mb']} MB RSS ({r['action']})")

    print(f"\n[+] Total memory {'reclaimed' if not args.dry_run else 'eligible'}: {total_rss:.1f} MB (~{total_rss/1024:.2f} GB)")


if __name__ == "__main__":
    main()
