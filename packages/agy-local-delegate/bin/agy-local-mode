#!/usr/bin/env bash
# agy-local-mode — launch AGY through a local Rapid-MLX model and Gemini proxy.
set -euo pipefail

resolve_script_dir() {
    local source_path="${BASH_SOURCE[0]}"
    while [[ -L "$source_path" ]]; do
        local source_dir
        source_dir="$(cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd)"
        source_path="$(readlink "$source_path")"
        [[ "$source_path" != /* ]] && source_path="$source_dir/$source_path"
    done
    cd -P "$(dirname "$source_path")" >/dev/null 2>&1 && pwd
}

SCRIPT_DIR="$(resolve_script_dir)"
DELEGATE_SCRIPT="$SCRIPT_DIR/agy_local_delegate.py"
PROXY_SCRIPT="$SCRIPT_DIR/agy_local_proxy.py"
CORE_DIR="$SCRIPT_DIR"
[[ -f "$CORE_DIR/agy_local_delegate_core.py" ]] || CORE_DIR="$(dirname "$SCRIPT_DIR")"

LOCAL_MODEL="${AGY_LOCAL_MODEL_ID:-qwen-3.8-operator}"
LOCAL_UPSTREAM="${AGY_LOCAL_MODEL_ENDPOINT:-}"
PROXY_PORT="${AGY_LOCAL_PROXY_PORT:-}"
PROXY_TIMEOUT="${AGY_LOCAL_PROXY_TIMEOUT:-180}"
SERVER_TIMEOUT="${AGY_LOCAL_SERVER_STARTUP_TIMEOUT:-900}"
FORCE_MENU=0
UPSTREAM_EXPLICIT=0
[[ -n "$LOCAL_UPSTREAM" ]] && UPSTREAM_EXPLICIT=1
AGY_ARGS=()

need_value() {
    if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "[agy-local-mode] ERROR: $1 requires a value" >&2
        exit 2
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --model) need_value "$@"; LOCAL_MODEL="$2"; shift 2 ;;
        --menu|-m) FORCE_MENU=1; shift ;;
        --upstream) need_value "$@"; LOCAL_UPSTREAM="$2"; UPSTREAM_EXPLICIT=1; shift 2 ;;
        --port) need_value "$@"; PROXY_PORT="$2"; shift 2 ;;
        --timeout) need_value "$@"; PROXY_TIMEOUT="$2"; shift 2 ;;
        --debug) export AGY_LOCAL_PROXY_DEBUG=1; shift ;;
        --) shift; AGY_ARGS+=("$@"); break ;;
        *) AGY_ARGS+=("$1"); shift ;;
    esac
done

for command_name in python3 agy; do
    if ! command -v "$command_name" >/dev/null 2>&1; then
        echo "[agy-local-mode] ERROR: $command_name not found" >&2
        exit 1
    fi
done
for required_file in "$DELEGATE_SCRIPT" "$PROXY_SCRIPT" "$CORE_DIR/agy_local_delegate_core.py"; do
    if [[ ! -f "$required_file" ]]; then
        echo "[agy-local-mode] ERROR: required file not found: $required_file" >&2
        exit 1
    fi
done

if [[ "$FORCE_MENU" -eq 1 ]]; then
    if ! CHOSEN_MODEL=$(python3 "$DELEGATE_SCRIPT" menu); then
        echo "[agy-local-mode] Selection cancelled."
        exit 0
    fi
    [[ -n "$CHOSEN_MODEL" ]] || { echo "[agy-local-mode] Selection cancelled."; exit 0; }
    LOCAL_MODEL="$CHOSEN_MODEL"
fi

# AGY honors GOOGLE_GEMINI_BASE_URL only with its Gemini API-key provider.
if [[ "${AGY_LOCAL_SKIP_PROVIDER_CHECK:-0}" != "1" ]]; then
    SETTINGS_PATH="${AGY_SETTINGS_PATH:-$HOME/.gemini/antigravity-cli/settings.json}"
    if ! python3 - "$SETTINGS_PATH" <<'PY_PROVIDER'
import json, os, sys
path = os.path.expanduser(sys.argv[1])
try:
    with open(path, encoding="utf-8") as handle:
        settings = json.load(handle)
except Exception:
    raise SystemExit(1)
raise SystemExit(0 if settings.get("modelProvider") == "gemini" else 1)
PY_PROVIDER
    then
        echo "[agy-local-mode] ERROR: AGY is not configured for its Gemini custom-endpoint provider." >&2
        echo "  Preserve your other settings, but add this to $SETTINGS_PATH:" >&2
        echo '  { "modelProvider": "gemini" }' >&2
        echo "  Without this, AGY can bypass the local proxy and consume cloud quota." >&2
        exit 1
    fi
fi

if [[ "${AGY_SKIP_RAM_PREFLIGHT:-0}" != "1" ]]; then
    set +e
    PREFLIGHT_OUT=$(python3 "$DELEGATE_SCRIPT" preflight --model "$LOCAL_MODEL" 2>&1)
    PREFLIGHT_STATUS=$?
    set -e
    printf '%s\n' "$PREFLIGHT_OUT"
    if [[ "$PREFLIGHT_STATUS" -ne 0 ]]; then
        echo "[agy-local-mode] ERROR: RAM preflight failed; refusing to load another model." >&2
        exit "$PREFLIGHT_STATUS"
    fi
fi

MODEL_JSON=$(PYTHONPATH="$CORE_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$LOCAL_MODEL" <<'PY_RESOLVE'
import json, sys
import agy_local_delegate_core as core
print(json.dumps(core.resolve_model_reference(sys.argv[1])))
PY_RESOLVE
)
MODEL_ID=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["model_id"])' <<<"$MODEL_JSON")
SERVE_ARG=$(python3 -c 'import json,sys; print(json.load(sys.stdin)["serve_arg"])' <<<"$MODEL_JSON")

OWNED_SERVER=0
OWNED_PROXY=0
SERVER_PID=""
PROXY_PID=""
RUNTIME_DIR="$(mktemp -d "${TMPDIR:-/tmp}/agy-local-mode.XXXXXX")"
SERVER_LOG="$RUNTIME_DIR/rapid-mlx.log"
PROXY_LOG="$RUNTIME_DIR/proxy.log"

cleanup() {
    local status=$?
    trap - EXIT INT TERM
    if [[ "$OWNED_PROXY" -eq 1 && -n "$PROXY_PID" ]]; then
        kill "$PROXY_PID" 2>/dev/null || true
        wait "$PROXY_PID" 2>/dev/null || true
    fi
    if [[ "$OWNED_SERVER" -eq 1 && -n "$SERVER_PID" ]]; then
        kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
    rm -rf "$RUNTIME_DIR"
    exit "$status"
}
trap cleanup EXIT INT TERM

endpoint_online() {
    PYTHONPATH="$CORE_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$1" <<'PY_HEALTH'
import sys
import agy_local_delegate_core as core
raise SystemExit(0 if core.check_server_health(sys.argv[1], timeout=1.5).get("online") else 1)
PY_HEALTH
}

find_free_port() {
    PYTHONPATH="$CORE_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$1" "$2" <<'PY_PORT'
import sys
import agy_local_delegate_core as core
print(core.find_free_port(int(sys.argv[1]), int(sys.argv[2])))
PY_PORT
}

if [[ "$UPSTREAM_EXPLICIT" -eq 0 ]]; then
    MATCH_JSON=$(PYTHONPATH="$CORE_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$LOCAL_MODEL" <<'PY_MATCH'
import json, sys
import agy_local_delegate_core as core
server = core.find_matching_model_server(sys.argv[1], 8000, 8015)
print(json.dumps(server or {}))
PY_MATCH
)
    MATCH_PORT=$(python3 -c 'import json,sys; print(json.load(sys.stdin).get("port", ""))' <<<"$MATCH_JSON")
    if [[ -n "$MATCH_PORT" ]]; then
        LOCAL_UPSTREAM="http://127.0.0.1:${MATCH_PORT}/v1"
        echo "[agy-local-mode] Reusing requested model on port $MATCH_PORT."
    fi
fi

if [[ -z "$LOCAL_UPSTREAM" ]]; then
    UPSTREAM_PORT=$(find_free_port 8000 8015)
    if [[ "$UPSTREAM_PORT" == "0" ]]; then
        echo "[agy-local-mode] ERROR: no free local model port in 8000-8015." >&2
        exit 1
    fi

    RAPID_MLX_BIN="${AGY_RAPID_MLX_BIN:-}"
    if [[ -z "$RAPID_MLX_BIN" ]]; then
        RAPID_MLX_BIN="$(command -v rapid-mlx 2>/dev/null || true)"
    fi
    if [[ -z "$RAPID_MLX_BIN" ]]; then
        for candidate in \
            "$HOME/.local/bin/rapid-mlx" \
            "$HOME/.rapid-mlx/bin/rapid-mlx" \
            "$HOME/.venvs/rapid-mlx-0.12.18/bin/rapid-mlx" \
            "/opt/homebrew/bin/rapid-mlx" \
            "/usr/local/bin/rapid-mlx"; do
            if [[ -x "$candidate" ]]; then RAPID_MLX_BIN="$candidate"; break; fi
        done
    fi
    if [[ -z "$RAPID_MLX_BIN" || ! -x "$RAPID_MLX_BIN" ]]; then
        echo "[agy-local-mode] ERROR: no matching server is running and rapid-mlx was not found." >&2
        echo "  Install Rapid-MLX or set AGY_RAPID_MLX_BIN=/absolute/path/to/rapid-mlx" >&2
        exit 1
    fi

    LOCAL_UPSTREAM="http://127.0.0.1:${UPSTREAM_PORT}/v1"
    echo "[agy-local-mode] Starting Rapid-MLX on port $UPSTREAM_PORT..."
    "$RAPID_MLX_BIN" serve "$SERVE_ARG" --port "$UPSTREAM_PORT" >"$SERVER_LOG" 2>&1 &
    SERVER_PID=$!
    OWNED_SERVER=1

    deadline=$((SECONDS + SERVER_TIMEOUT))
    while ! endpoint_online "$LOCAL_UPSTREAM"; do
        if ! kill -0 "$SERVER_PID" 2>/dev/null; then
            echo "[agy-local-mode] ERROR: Rapid-MLX exited during startup." >&2
            tail -n 80 "$SERVER_LOG" >&2 || true
            exit 1
        fi
        if (( SECONDS >= deadline )); then
            echo "[agy-local-mode] ERROR: Rapid-MLX did not become ready within ${SERVER_TIMEOUT}s." >&2
            tail -n 80 "$SERVER_LOG" >&2 || true
            exit 1
        fi
        sleep 1
    done
elif ! endpoint_online "$LOCAL_UPSTREAM"; then
    echo "[agy-local-mode] ERROR: configured upstream is not OpenAI-compatible or is offline: $LOCAL_UPSTREAM" >&2
    exit 1
fi

SERVED_MODEL=$(PYTHONPATH="$CORE_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$LOCAL_UPSTREAM" "$LOCAL_MODEL" <<'PY_MODEL'
import sys
import agy_local_delegate_core as core
print(core.get_server_model(sys.argv[1], requested=sys.argv[2], timeout=3) or "")
PY_MODEL
)
if [[ -z "$SERVED_MODEL" ]]; then
    echo "[agy-local-mode] ERROR: upstream returned no model from /v1/models." >&2
    exit 1
fi
# A just-started server is known to host SERVE_ARG. An auto-reused server was matched before this point.
MODEL_ID="$SERVED_MODEL"

if [[ -z "$PROXY_PORT" ]]; then
    PROXY_PORT=$(find_free_port 9191 9205)
    if [[ "$PROXY_PORT" == "0" ]]; then
        echo "[agy-local-mode] ERROR: no free proxy port in 9191-9205." >&2
        exit 1
    fi
else
    FREE_CHECK=$(find_free_port "$PROXY_PORT" "$PROXY_PORT")
    if [[ "$FREE_CHECK" == "0" ]]; then
        echo "[agy-local-mode] ERROR: requested proxy port $PROXY_PORT is already occupied; it will not be killed." >&2
        exit 1
    fi
fi

PROXY_ARGS=(python3 "$PROXY_SCRIPT" --port "$PROXY_PORT" --upstream "$LOCAL_UPSTREAM" --model "$MODEL_ID" --timeout "$PROXY_TIMEOUT")
[[ -n "${AGY_LOCAL_PROXY_DEBUG:-}" ]] && PROXY_ARGS+=(--debug)
echo "[agy-local-mode] Starting Gemini proxy on free port $PROXY_PORT..."
"${PROXY_ARGS[@]}" >"$PROXY_LOG" 2>&1 &
PROXY_PID=$!
OWNED_PROXY=1

PROXY_BASE="http://127.0.0.1:$PROXY_PORT"
proxy_deadline=$((SECONDS + 15))
while ! python3 - "$PROXY_BASE" <<'PY_PROXY_HEALTH'
import sys, urllib.request
try:
    with urllib.request.urlopen(sys.argv[1].rstrip("/") + "/health", timeout=1) as response:
        raise SystemExit(0 if response.status == 200 else 1)
except Exception:
    raise SystemExit(1)
PY_PROXY_HEALTH
do
    if ! kill -0 "$PROXY_PID" 2>/dev/null; then
        echo "[agy-local-mode] ERROR: proxy exited during startup on port $PROXY_PORT." >&2
        cat "$PROXY_LOG" >&2 || true
        exit 1
    fi
    if (( SECONDS >= proxy_deadline )); then
        echo "[agy-local-mode] ERROR: proxy failed health verification on port $PROXY_PORT." >&2
        cat "$PROXY_LOG" >&2 || true
        exit 1
    fi
    sleep 0.25
done

if [[ "${AGY_LOCAL_SKIP_SMOKE:-0}" != "1" ]]; then
    SMOKE_JSON=$(PYTHONPATH="$CORE_DIR${PYTHONPATH:+:$PYTHONPATH}" python3 - "$PROXY_BASE" "$PROXY_TIMEOUT" <<'PY_SMOKE'
import json, sys
import agy_local_delegate_core as core
print(json.dumps(core.smoke_test_gemini_proxy(sys.argv[1], timeout=float(sys.argv[2]))))
PY_SMOKE
)
    if [[ "$(python3 -c 'import json,sys; print("1" if json.load(sys.stdin).get("success") else "0")' <<<"$SMOKE_JSON")" != "1" ]]; then
        echo "[agy-local-mode] ERROR: end-to-end local inference smoke test failed." >&2
        python3 -c 'import json,sys; print(json.load(sys.stdin).get("error", "unknown error"))' <<<"$SMOKE_JSON" >&2
        tail -n 80 "$SERVER_LOG" >&2 2>/dev/null || true
        tail -n 80 "$PROXY_LOG" >&2 2>/dev/null || true
        exit 1
    fi
fi

echo "┌─────────────────────────────────────────────────────────┐"
echo "│  AGY local mode verified                                 │"
echo "├─────────────────────────────────────────────────────────┤"
echo "│  Upstream: $LOCAL_UPSTREAM"
echo "│  Model:    $MODEL_ID"
echo "│  Proxy:    $PROXY_BASE"
echo "└─────────────────────────────────────────────────────────┘"
echo "[agy-local-mode] Launching AGY. Local smoke test passed."

GEMINI_API_KEY="${GEMINI_API_KEY:-local-loopback-only}" \
GOOGLE_GEMINI_BASE_URL="$PROXY_BASE" \
agy "${AGY_ARGS[@]}"
