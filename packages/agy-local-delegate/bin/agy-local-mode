#!/usr/bin/env bash
# ============================================================================
# agy-local-mode — Launch AGY with a local model as the main engine
#
# This script:
#   1. Starts the agy-local-proxy (Gemini→OpenAI translation layer)
#   2. Sets GOOGLE_GEMINI_BASE_URL to point AGY at the proxy
#   3. Launches AGY in interactive mode
#   4. Cleans up the proxy when AGY exits
#
# Usage:
#   agy-local-mode [--model <model-id>] [--upstream <url>] [--port <port>] [AGY_ARGS...]
#
# Examples:
#   # Default: Qwen 3.8 on port 8000 (Rapid-MLX default)
#   agy-local-mode
#
#   # Specific model and upstream
#   agy-local-mode --model mlx-community/Qwen3.8-27B-4bit --upstream http://127.0.0.1:8000/v1
#
#   # Pass additional AGY flags
#   agy-local-mode --continue
#   agy-local-mode --mode plan
# ============================================================================

set -euo pipefail

# ---------------------------------------------------------------------------
# Defaults (can be overridden by env vars or flags)
# ---------------------------------------------------------------------------
PROXY_PORT="${AGY_LOCAL_PROXY_PORT:-9191}"
LOCAL_UPSTREAM="${AGY_LOCAL_MODEL_ENDPOINT:-http://127.0.0.1:8000/v1}"
LOCAL_MODEL="${AGY_LOCAL_MODEL_ID:-mlx-community/Qwen3.8-27B-4bit}"
PROXY_TIMEOUT="${AGY_LOCAL_PROXY_TIMEOUT:-180}"
PROXY_DEBUG="${AGY_LOCAL_PROXY_DEBUG:-}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROXY_SCRIPT="$SCRIPT_DIR/agy_local_proxy.py"

# ---------------------------------------------------------------------------
# Parse local flags (strip before passing remainder to agy)
# ---------------------------------------------------------------------------
AGY_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --model)    LOCAL_MODEL="$2"; shift 2 ;;
        --upstream) LOCAL_UPSTREAM="$2"; shift 2 ;;
        --port)     PROXY_PORT="$2"; shift 2 ;;
        --timeout)  PROXY_TIMEOUT="$2"; shift 2 ;;
        --debug)    PROXY_DEBUG="--debug"; shift ;;
        *)          AGY_ARGS+=("$1"); shift ;;
    esac
done

# ---------------------------------------------------------------------------
# Check prerequisites
# ---------------------------------------------------------------------------
if ! command -v python3 &>/dev/null; then
    echo "[agy-local-mode] ERROR: python3 not found" >&2
    exit 1
fi
if ! command -v agy &>/dev/null; then
    echo "[agy-local-mode] ERROR: agy CLI not found" >&2
    exit 1
fi
if [[ ! -f "$PROXY_SCRIPT" ]]; then
    echo "[agy-local-mode] ERROR: proxy script not found at $PROXY_SCRIPT" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# 1. RAM Preflight Check (Cheapest first, prevent system lockup)
# ---------------------------------------------------------------------------
if [[ "${AGY_SKIP_RAM_PREFLIGHT:-0}" != "1" ]]; then
    PREFLIGHT_OUT=$(python3 "$SCRIPT_DIR/agy_local_delegate.py" preflight --model "$LOCAL_MODEL" 2>&1 || true)
    if echo "$PREFLIGHT_OUT" | grep -q "UNSAFE"; then
        echo "$PREFLIGHT_OUT"
        echo ""
        echo "🛑 RAM preflight failed: loading $LOCAL_MODEL may freeze system memory."
        echo "   Set AGY_SKIP_RAM_PREFLIGHT=1 to bypass if you know what you are doing."
        exit 1
    else
        echo "$PREFLIGHT_OUT"
    fi
fi

# ---------------------------------------------------------------------------
# 2. Dynamic Upstream Server Discovery (8000-8015)
# ---------------------------------------------------------------------------
if [[ "$LOCAL_UPSTREAM" == "http://127.0.0.1:8000/v1" ]]; then
    # Auto-scan ports 8000-8015 for active model server
    DISCOVERED_PORT=$(python3 -c "
import sys, os
sys.path.insert(0, os.path.dirname('$SCRIPT_DIR'))
import agy_local_delegate_core as core
servers = core.find_active_model_servers(8000, 8015)
if servers:
    print(servers[0]['port'])
" 2>/dev/null || true)
    if [[ -n "$DISCOVERED_PORT" ]]; then
        LOCAL_UPSTREAM="http://127.0.0.1:${DISCOVERED_PORT}/v1"
        echo "[agy-local-mode] 🔌 Discovered active inference server on port $DISCOVERED_PORT ($LOCAL_UPSTREAM)"
    fi
fi

# ---------------------------------------------------------------------------
# 3. Dynamic Proxy Port Discovery (9191-9205)
# ---------------------------------------------------------------------------
if [[ -z "${AGY_LOCAL_PROXY_PORT:-}" ]]; then
    DYNAMIC_PROXY_PORT=$(python3 -c "
import sys, os
sys.path.insert(0, os.path.dirname('$SCRIPT_DIR'))
import agy_local_delegate_core as core
# Check if existing proxy is active
for p in range(9191, 9205):
    res = core.check_server_health(f'http://127.0.0.1:{p}', timeout=0.3)
    # Check if proxy health responds
    try:
        import urllib.request
        with urllib.request.urlopen(f'http://127.0.0.1:{p}/health', timeout=0.3) as resp:
            if resp.status == 200:
                print(p)
                sys.exit(0)
    except Exception:
        pass
# Otherwise return first free port
print(core.find_free_port(9191, 9205))
" 2>/dev/null || true)
    if [[ -n "$DYNAMIC_PROXY_PORT" ]]; then
        PROXY_PORT="$DYNAMIC_PROXY_PORT"
    fi
fi

echo "┌─────────────────────────────────────────────────────────┐"
echo "│  agy-local-mode: Local Model Mode                        │"
echo "├─────────────────────────────────────────────────────────┤"
echo "│  Upstream:    $LOCAL_UPSTREAM"
echo "│  Model:       $LOCAL_MODEL"
echo "│  Proxy Port:  $PROXY_PORT (dynamic free slot)"
echo "└─────────────────────────────────────────────────────────┘"
echo ""

# Check if upstream is alive
if ! curl -sf "${LOCAL_UPSTREAM%/v1}/health" --max-time 2 &>/dev/null && \
   ! curl -sf "${LOCAL_UPSTREAM}/models" --max-time 2 &>/dev/null; then
    echo "[agy-local-mode] ⚠️  WARNING: Local model server not detected at $LOCAL_UPSTREAM"
    echo "                    Start Rapid-MLX (MLX) or llama-server (GGUF) first, e.g.:"
    echo "                    ~/.venvs/rapid-mlx-0.12.18/bin/rapid-mlx \\"
    echo "                      --model ~/.models/Qwen3.8-27B-4bit"
    echo ""
    read -r -p "Continue anyway? [y/N] " CONFIRM
    [[ "${CONFIRM:-N}" =~ ^[Yy]$ ]] || exit 0
fi

# ---------------------------------------------------------------------------
# 4. Proxy Lifecycle & Startup
# ---------------------------------------------------------------------------
OWNED_PROXY=0
if curl -sf "http://127.0.0.1:$PROXY_PORT/health" --max-time 1 &>/dev/null; then
    echo "[agy-local-mode] Existing healthy proxy active on port $PROXY_PORT. Reusing..."
else
    # Check if port is occupied by a stale non-proxy process
    EXISTING_PID=$(lsof -ti :"$PROXY_PORT" 2>/dev/null || true)
    if [[ -n "$EXISTING_PID" ]]; then
        echo "[agy-local-mode] Cleaning up stale process on port $PROXY_PORT (PID $EXISTING_PID)..."
        kill -9 "$EXISTING_PID" 2>/dev/null || true
        sleep 0.5
    fi

    PROXY_CMD="python3 $PROXY_SCRIPT --port $PROXY_PORT --upstream $LOCAL_UPSTREAM --model $LOCAL_MODEL --timeout $PROXY_TIMEOUT $PROXY_DEBUG"
    echo "[agy-local-mode] Starting Gemini→OpenAI proxy on port $PROXY_PORT..."
    $PROXY_CMD &
    PROXY_PID=$!
    OWNED_PROXY=1

    # Wait for proxy to be ready
    WAIT=0
    while ! curl -sf "http://127.0.0.1:$PROXY_PORT/health" --max-time 1 &>/dev/null; do
        sleep 0.2
        WAIT=$((WAIT + 1))
        if [[ $WAIT -gt 25 ]]; then
            echo "[agy-local-mode] ERROR: Proxy failed to start on port $PROXY_PORT" >&2
            kill "$PROXY_PID" 2>/dev/null || true
            exit 1
        fi
    done
fi

echo "[agy-local-mode] Proxy ready on port $PROXY_PORT"
echo "[agy-local-mode] Launching AGY..."
echo ""

# ---------------------------------------------------------------------------
# 5. Cleanup on exit
# ---------------------------------------------------------------------------
cleanup() {
    if [[ "$OWNED_PROXY" -eq 1 && -n "${PROXY_PID:-}" ]]; then
        echo ""
        echo "[agy-local-mode] Stopping proxy (PID $PROXY_PID)..."
        kill "$PROXY_PID" 2>/dev/null || true
        wait "$PROXY_PID" 2>/dev/null || true
        echo "[agy-local-mode] Done."
    fi
}
trap cleanup EXIT INT TERM

# ---------------------------------------------------------------------------
# 6. Launch AGY with proxy base URL
# ---------------------------------------------------------------------------
GOOGLE_GEMINI_BASE_URL="http://127.0.0.1:$PROXY_PORT" agy "${AGY_ARGS[@]}"
